# Supabase Configuration
# Dans Vercel (Project Settings > Environment Variables), définissez ces variables :
# VITE_SUPABASE_URL : URL de votre projet (ex: https://xyz.supabase.co ou l'identifiant du projet)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# VITE_SUPABASE_ANON_KEY : Clé d'API publique anonyme de votre projet Supabase
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
